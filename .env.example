# Template for the environment variables the app reads.
# Copy this file to .env (which is git-ignored) and fill in real values there.
# Never put real values in this file: it IS committed to git.

# PostgreSQL connection string, e.g. from Neon (Dashboard > Connect).
# Leave empty to use the local SQLite file tracker.db instead.
DATABASE_URL=

# Password for the "admin" account. Leave empty to get a random one printed on first start.
ADMIN_PASSWORD=

# Set to true when the app is served over HTTPS (it is on Render).
COOKIE_SECURE=

# Sentry error monitoring (Sentry > Project Settings > Client Keys (DSN)). Leave empty to keep Sentry off.
SENTRY_DSN=
# Optional: label shown on each Sentry issue. Defaults to "production" on Render, "development" elsewhere.
SENTRY_ENVIRONMENT=

# Claude API key (console.anthropic.com > API keys) for the "Suggest title" AI feature. SECRET.
# Leave empty to keep the feature off.
ANTHROPIC_API_KEY=
# Optional: model (default claude-opus-5-5) and limits (defaults 5 per user per minute, 30 per user per day, 50 per day in total).
AI_MODEL=
AI_RATE_LIMIT_PER_MINUTE=
AI_RATE_LIMIT_PER_DAY=
AI_GLOBAL_LIMIT_PER_DAY=
